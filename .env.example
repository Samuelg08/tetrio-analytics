# Índice de variables de entorno de referencia (C4)
# No asumas que cada herramienta carga este archivo raíz automáticamente.
# Consulta las plantillas específicas por módulo:
#   - backend/.env.example
#   - frontend/.env.example
#   - ai_service/.env.example

# --- Spring Boot (backend/.env.example) ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=tetrio_analytics_dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
TETRA_CHANNEL_BASE_URL=https://ch.tetr.io/api
TETRA_CHANNEL_TIMEOUT_MS=5000
TETRA_CHANNEL_MIN_INTERVAL_MS=1100
TETRA_CHANNEL_ACQUIRE_TIMEOUT_MS=3000
CACHE_TTL_SECONDS=300
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=3000
EXTRACTION_ENABLED=false

# --- SvelteKit (frontend/.env.example) ---
PUBLIC_API_BASE_URL=http://localhost:8080/api

# --- FastAPI (ai_service/.env.example) ---
AI_HOST=127.0.0.1
AI_PORT=8000
AI_MODEL_PATH=artifacts/model.joblib
AI_MODEL_CARD_PATH=artifacts/model_card.json
