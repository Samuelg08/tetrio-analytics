# Plantilla de variables de entorno para Backend (Spring Boot)
# IMPORTANTE: Spring Boot no carga archivos .env automáticamente por defecto.
# Define estas variables en tu entorno/IDE o copia este archivo a backend/.env
# e impórtalo explícitamente en application.yml (spring.config.import=optional:file:.env[.properties]).
# Nunca subas credenciales reales de MongoDB Atlas a Git.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# MongoDB Atlas (reemplazar localmente con tu usuario individual de privilegios mínimos)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=tetrio_analytics_dev

# CORS (lista explícita separada por comas, sin comodines '*')
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cliente TETRA CHANNEL y rate limiter compartido
TETRA_CHANNEL_BASE_URL=https://ch.tetr.io/api
TETRA_CHANNEL_TIMEOUT_MS=5000
TETRA_CHANNEL_MIN_INTERVAL_MS=1100
TETRA_CHANNEL_ACQUIRE_TIMEOUT_MS=3000
CACHE_TTL_SECONDS=300

# Microservicio interno de IA (FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=3000

# Pipeline de extracción masiva (nunca activar en el servidor web; usar solo con perfil CLI 'extraction')
EXTRACTION_ENABLED=false
EXTRACTION_PHASES=leaderboard_league
EXTRACTION_BATCH_SIZE=100
EXTRACTION_MAX_RETRIES=3
EXTRACTION_MAX_CONSECUTIVE_ERRORS=5
EXTRACTION_RAW_DIR=../data/raw
EXTRACTION_PROCESSED_DIR=../data/processed
